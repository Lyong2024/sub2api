# Sub2API DIY environment example
# Copy to .env in the working directory (does not override existing shell env)

DEPLOY_MODE=diy
AUTO_SETUP=true

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release

DATABASE_DRIVER=sqlite
DATABASE_PATH=./data/sub2api.db

REDIS_EMBEDDED=true

# Bootstrap admin (empty password → auto-generated once and printed)
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# JWT must be >= 32 bytes; empty → auto-generated
JWT_SECRET=

RUN_MODE=standard
TZ=Asia/Shanghai
DATA_DIR=.

# systemd install uses:
# DATA_DIR=/var/lib/sub2api
# EnvironmentFile=/etc/sub2api/sub2api.env
